# Copie este arquivo para .env e preencha os valores corretos.

# Credenciais do projeto Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=SUA_CHAVE_DE_API

# Secret usada para assinar os tokens JWT de sessÃ£o
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Tempo de validade do token de acesso em minutos (padrÃ£o: 480 = 8 horas)
JWT_VALIDADE_MINUTOS=720

# Origens permitidas no CORS (separadas por vÃ­rgula, sem espaÃ§os)
# Em produÃ§Ã£o, use o domÃ­nio real do frontend (ex: https://app.vercel.app)
# NUNCA use "*" junto com allow_credentials=True em produÃ§Ã£o.
CORS_ORIGINS=https://app-munaretto-sand.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5198,http://127.0.0.1:5198,http://localhost:5199,http://127.0.0.1:5199

# Ambiente da aplicaÃ§Ã£o: development ou production
# Em production, o Swagger (/docs) e o schema OpenAPI sÃ£o desabilitados.
APP_ENV=development

# NÃ­vel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Em production o log sai em formato JSON; em development em texto legÃ­vel.
LOG_LEVEL=INFO

# --- Armazenamento de certificados no Backblaze B2 (bucket PRIVADO) ---
# Crie o bucket no painel do B2 com a opÃ§Ã£o "Private". Estas credenciais sÃ£o
# as do Application Key geradas em App Keys (nunca as credenciais mestras).
# Endpoint da regiÃ£o do bucket: https://s3.<regiao>.backblazeb2.com
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=M
# RegiÃ£o do bucket (padrÃ£o us-west-004). Omita se for a padrÃ£o.
B2_REGION=us-west-004
