# Copie este arquivo para .env e preencha os valores corretos.

# Credenciais do projeto Supabase.
# ATENÇÃO: use SEMPRE a chave service_role (Project Settings -> API).
# O schema.sql habilita RLS e apenas o service_role tem acesso; a chave anon
# NAO funciona e faz todos os endpoints falharem.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=SUA_CHAVE_SERVICE_ROLE_NUNCA_NO_FRONTEND

# Secret usada para assinar os tokens JWT de sessão
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Tempo de validade do token de acesso em minutos (padrão: 960 = 16 horas)
JWT_VALIDADE_MINUTOS=960

# Origens permitidas no CORS (separadas por vírgula, sem espaços)
# Em produção, use o domínio real do frontend (ex: https://app.vercel.app)
# NUNCA use "*" junto com allow_credentials=True em produção.
CORS_ORIGINS=https://app-munaretto-sand.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5198,http://127.0.0.1:5198,http://localhost:5199,http://127.0.0.1:5199

# Ambiente da aplicação: development ou production (padrão: production)
# Em produção o Swagger (/docs) e o schema OpenAPI ficam desabilitados.
# Para desenvolvimento local, defina explicitamente APP_ENV=development.
APP_ENV=development

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Em production o log sai em formato JSON; em development em texto legível.
LOG_LEVEL=INFO

# Hosts aceitos na API (defesa contra host header poisoning), separados por
# vírgula. Ex.: app-munaretto.onrender.com,localhost,127.0.0.1. Vazio = permite todos.
TRUSTED_HOSTS=

# Senha do administrador criado no primeiro boot (mínimo 8 caracteres).
# Se ficar vazia, uma senha aleatória é gravada em backend/admin_inicial.txt.
# A senha nunca aparece nos logs do servidor.
ADMIN_SENHA_INICIAL=

# --- Armazenamento de certificados no Backblaze B2 (bucket PRIVADO) ---
# Crie o bucket no painel do B2 com a opção "Private". Estas credenciais são
# as do Application Key geradas em App Keys (nunca as credenciais mestras).
# Endpoint da região do bucket: https://s3.<regiao>.backblazeb2.com
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=SEU_BUCKET
# Região do bucket (padrão us-west-004). Omita se for a padrão.
B2_REGION=us-west-004
