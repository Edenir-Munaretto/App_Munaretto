# Copie este arquivo para .env e preencha os valores corretos.

# Credenciais do projeto Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=SUA_CHAVE_DE_API

# Secret usada para assinar os tokens JWT de sessão
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Tempo de validade do token de acesso em minutos (padrão: 480 = 8 horas)
JWT_VALIDADE_MINUTOS=480

# Origens permitidas no CORS (separadas por vírgula, sem espaços)
# Em produção, use apenas o domínio real do frontend (ex: https://app.munaretto.com.br)
# NUNCA use "*" junto com allow_credentials=True em produção.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
