# Copie este arquivo para .env e preencha os valores corretos.

# Credenciais do projeto Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=SUA_CHAVE_DE_API

# Secret usada para assinar os tokens JWT de sessão
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Tempo de validade do token de acesso em minutos (padrão: 480 = 8 horas)
JWT_VALIDADE_MINUTOS=480

# Origens permitidas no CORS (separadas por vírgula, sem espaços)
# Em produção, use o domínio real do frontend (ex: https://app.vercel.app)
# NUNCA use "*" junto com allow_credentials=True em produção.
CORS_ORIGINS=https://app-munaretto-sand.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# --- Armazenamento de certificados no Backblaze B2 (bucket PRIVADO) ---
# Crie o bucket no painel do B2 com a opção "Private". Estas credenciais são
# as do Application Key geradas em App Keys (nunca as credenciais mestras).
# Endpoint da região do bucket: https://s3.<regiao>.backblazeb2.com
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=M
# Região do bucket (padrão us-west-004). Omita se for a padrão.
B2_REGION=us-west-004
