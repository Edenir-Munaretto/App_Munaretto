# Copie este arquivo para .env.backup e preencha com a connection string do Postgres.
# Obtenha em: Dashboard do Supabase -> Project Settings -> Database -> Connection string.
# Use o host de conexao DIRETA (db.<ref>.supabase.co) e adicione sslmode=require.
# Obrigatorio definir senha de banco em: Project Settings -> Database -> Reset database password.

SUPABASE_DB_URL=postgresql://postgres.SEU_REFERENCIA:SUA_SENHA@db.SEU_REFERENCIA.supabase.co:5432/postgres?sslmode=require